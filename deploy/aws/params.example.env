# Copy to deploy/aws/params.env and fill in. params.env is gitignored via
# the pattern below in scripts (do not commit real values).

AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012

# ECR
ECR_REPOSITORY=chat-analytics-backend
IMAGE_TAG=latest

# ECS
ECS_CLUSTER=chat-analytics
ECS_SERVICE=chat-analytics-backend
TASK_FAMILY=chat-analytics-backend
# Optional: path to a substituted task def; default is rendered next to scripts
# TASK_DEFINITION_FILE=

# Public frontend origin (CloudFront or custom domain) — also used for ALLOWED_ORIGINS
FRONTEND_ORIGIN=d111111abcdef8.cloudfront.net

# Backend URLs baked into the Vite build
API_URL=https://api.example.com
WS_URL=wss://api.example.com/ws

# Frontend static hosting
S3_BUCKET=chat-analytics-frontend
CLOUDFRONT_DISTRIBUTION_ID=E1234567890ABC

# Optional smoke targets (defaults derived from API_URL / CloudFront)
# HEALTH_URL=https://api.example.com/readyz
# FRONTEND_URL=https://d111111abcdef8.cloudfront.net
