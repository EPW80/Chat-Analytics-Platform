PORT=8080
# Local only. Leave unset (or empty) in ECS so the task role talks to AWS DynamoDB.
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_REGION=us-east-1
AWS_ACCESS_KEY_ID=dummy
AWS_SECRET_ACCESS_KEY=dummy
LOG_LEVEL=info

# CORS / WebSocket origin allowlist (comma-separated). "*" allows all (dev only).
ALLOWED_ORIGINS=*

# HMAC secret for signed auth tokens. Empty disables auth and falls back to the
# userId query parameter (development only).
AUTH_SECRET=

# Per-connection inbound rate limiting. RATE_LIMIT_PER_SEC<=0 disables it.
RATE_LIMIT_PER_SEC=5
RATE_LIMIT_BURST=10

# Persistence worker pool tuning.
PERSIST_WORKERS=4
PERSIST_BATCH_SIZE=25
PERSIST_QUEUE_SIZE=1024

# --- Voice Ops Briefings ---

# Feature flag. Off by default — the briefing service and detector are optional
# deps, nil-wired when this is false, exactly like storage/analytics.
BRIEFING_ENABLED=false

# ElevenLabs credentials. This file is a TEMPLATE and is committed — put real
# values in backend/.env (gitignored), never here.
#   cp backend/.env.example backend/.env   then fill these in
# Find voice IDs with:
#   curl -H "xi-api-key: $ELEVENLABS_API_KEY" https://api.elevenlabs.io/v1/voices
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Model. eleven_flash_v2_5 is fast and ~half the credit cost; switch to
# eleven_multilingual_v2 only if flash sounds flat in the demo.
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Monthly character budget guard (free tier ~10000). Past this, synthesis is
# refused and briefings degrade to text-only.
BRIEFING_MONTHLY_CHAR_BUDGET=10000

# Where synthesized mp3s are written. Must be on the persisted Docker volume.
BRIEFING_AUDIO_DIR=/data/briefings
